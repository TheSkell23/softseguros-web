---
import '../styles/global.css';
import SeoHead from '../components/layout/SeoHead.astro';
import type { Lang, PageKey } from '../i18n/routes.ts';
import type { PageSeo } from '../data/seo.ts';
import { heroHeadScript } from '../data/hero-images.ts';
import inter400 from '@fontsource/inter-tight/files/inter-tight-latin-400-normal.woff2?url';
import inter500 from '@fontsource/inter-tight/files/inter-tight-latin-500-normal.woff2?url';
import inter600 from '@fontsource/inter-tight/files/inter-tight-latin-600-normal.woff2?url';
import serif400 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';

interface Props {
  pageKey: PageKey;
  lang: Lang;
  seo: PageSeo;
  canonicalPath?: string;
  alternatePaths?: { lang: Lang; path: string }[];
  /** false en las páginas autónomas (404, Offline), que no llevan hero. */
  hero?: boolean;
}

const { pageKey, lang, seo, canonicalPath, alternatePaths, hero = true } = Astro.props;
const fonts = [inter400, inter500, inter600, serif400];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      pageKey={pageKey}
      lang={lang}
      seo={seo}
      canonicalPath={canonicalPath}
      alternatePaths={alternatePaths}
    />
    {fonts.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    {hero && <script is:inline set:html={heroHeadScript(pageKey)} />}
    <link rel="icon" type="image/webp" href="/uploads/logo.webp" />
    <slot name="styles" />
    {/* Sin JavaScript nadie añade `.ss-in`: el contenido con revelado quedaría invisible. */}
    <noscript>
      <style is:inline>
        .ss-reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
