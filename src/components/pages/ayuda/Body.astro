<div style="position:relative;max-width:1120px;margin:0 auto;padding:0 5%"> <div style="height:44px"></div> <div style="padding-top:44px;display:flex;flex-direction:column;gap:28px"><div id="categorias" style="scroll-margin-top:90px;display:flex;flex-direction:column;gap:22px"><div style="display:flex;flex-direction:column;gap:6px"><h2 style="margin:0;font:600 clamp(26px,3.2vw,36px)/1.12 'Inter Tight',sans-serif;letter-spacing:-.03em;color:#0B1B3F">{t("Elige tu tipo de ayuda")}</h2><p style="margin:0;max-width:640px;font:400 16px/1.5 'Inter Tight',sans-serif;color:#3d5a85">{t("Guías, novedades, videos y formación en un solo lugar.")}</p></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:18px"><div style="background:linear-gradient(180deg,#fff,#f1f6ff);border:1px solid rgba(255,255,255,.95);border-radius:26px;box-shadow:inset 0 1px 0 #fff,0 12px 32px rgba(26,115,232,.12);padding:26px;display:flex;flex-direction:column;gap:12px"><span style="width:46px;height:46px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(180deg,#7fdcff,#1779e6);box-shadow:0 6px 14px rgba(15,80,190,.3),inset 0 1px 0 rgba(255,255,255,.8)"><svg viewBox="0 0 24 24" style="width:23px;height:23px;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round"><path d="M4 5a2 2 0 012-2h12v16H6a2 2 0 00-2 2V5zm2 14h12M8 7h6"></path></svg></span><span style="font:600 12px 'Inter Tight',sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#1e5fd9">{t("Manuales de uso")}</span><h3 style="margin:0;font:600 20px/1.25 'Inter Tight',sans-serif;color:#0B1B3F;letter-spacing:-.01em">{t("Guías")}</h3><p style="margin:0;font:400 15px/1.55 'Inter Tight',sans-serif;color:#3d5a85">{t("Guías paso a paso y documentación detallada para cada módulo.")}</p></div><div style="background:linear-gradient(180deg,#fff,#f1f6ff);border:1px solid rgba(255,255,255,.95);border-radius:26px;box-shadow:inset 0 1px 0 #fff,0 12px 3