const h = {"items":[{"q":"¿Dónde encuentro ayuda para usar el software?","a":"En el centro de ayuda hay videos y guías para aprender a usar Softseguros. El soporte está disponible mientras tu licencia esté vigente y los pagos al día.","exp":true,"icon":"flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font:500 20px/1 'Inter Tight',sans-serif;color:#1e5fd9;background:linear-gradient(180deg,#fff,#e4f0ff);border:1px solid #fff;box-shadow:0 4px 10px rgba(26,115,232,.14);transition:transform .2s;transform:rotate(45deg)","ans":"padding:0 46px 22px 0;font:400 16px/1.6 'Inter Tight',sans-serif;color:#3d5a85"},{"q":"Ya acepté las condiciones, ¿cómo empiezo?","a":"Recibes por correo las instrucciones iniciales y tus claves de acceso. Después el equipo te contacta para agendar las capacitaciones.","exp":false,"icon":"flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font:500 20px/1 'Inter Tight',sans-serif;color:#1e5fd9;background:linear-gradient(180deg,#fff,#e4f0ff);border:1px solid #fff;box-shadow:0 4px 10px rgba(26,115,232,.14);transition:transform .2s;transform:rotate(0deg)","ans":"display:none"},{"q":"¿Cuánto tiempo toma implementar Softseguros?","a":"Conectar la primera aseguradora toma menos de una hora, y el equipo te acompaña con soporte humano en el resto de la puesta en marcha.","exp":false,"icon":"flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font:500 20px/1 'Inter Tight',sans-serif;color:#1e5fd9;background:linear-gradient(180deg,#fff,#e4f0ff);border:1px solid #fff;box-shadow:0 4px 10px rgba(26,115,232,.14);transition:transform .2s;transform:rotate(0deg)","ans":"display:none"},{"q":"¿Puedo traer mis clientes y pólizas actuales?","a":"Sí. Te damos las plantillas para importar desde Excel o desde tu sistema anterior, y el equipo te ayuda por chat.","exp":false,"icon":"flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font:500 20px/1