<div style="position:relative;max-width:1120px;margin:0 auto;padding:0 5%"> <div style="height:44px"></div> <div style="padding-top:44px;display:flex;flex-direction:column;gap:28px"><div id="destacado" style="scroll-margin-top:90px;position:relative;overflow:hidden;border-radius:34px;padding:clamp(28px,5vw,56px);color:#fff;background:linear-gradient(135deg,rgba(255,255,255,.28),rgba(255,255,255,0) 45%),linear-gradient(180deg,rgba(59,140,255,.96),rgba(26,63,209,.98));border:1px solid rgba(255,255,255,.6);box-shadow:0 18px 40px rgba(26,115,232,.28);text-shadow:0 1px 2px rgba(5,35,130,.4);display:flex;flex-direction:column;gap:16px;align-items:flex-start"><span style="display:inline-flex;padding:6px 14px;border-radius:999px;font:600 12px 'Inter Tight',sans-serif;letter-spacing:.08em;text-transform:uppercase;border:1px solid rgba(255,255,255,.55);background:rgba(255,255,255,.16)">{t("Nuevo artículo")}</span><h2 style="margin:0;max-width:820px;font:600 clamp(26px,3.6vw,42px)/1.12 'Inter Tight',sans-serif;letter-spacing:-.03em;text-wrap:balance">{t("Indicadores de gestión para agencias de seguros: los 12 KPIs que debes medir cada mes")}</h2><p style="margin:0;max-width:640px;font:400 17px/1.55 'Inter Tight',sans-serif;opacity:.95">{t("Los 12 indicadores que te muestran cómo va tu agencia y dónde actuar primero.")}</p><span style="font:500 14px 'Inter Tight',sans-serif;opacity:.92">{t("Crecimiento · Por Dany Castaño")}</span></div><div id="articulos" style="scroll-margin-top:90px;display:flex;flex-direction:column;gap:16px"><div style="display:flex;flex-direction:column;gap:6px"><h2 style="margin:0;font:600 clamp(26px,3.2vw,36px)/1.12 'Inter Tight',sans-serif;letter-spacing:-.03em;color:#0B1B3F">{t("Artículos y recursos")}</h2><p style="margin:0;font:400 16px/1.5 'Inter Tight',sans-serif;color:#3d5a85">{t("Filtra por tema o busca lo que necesitas.")}</p></div><input type="search" aria-label={t("Buscar artículos")} placeholder={t("Buscar artículos…")} data-blog-search="" style="width:100%;box-sizing:border-box;height:50px;padding:0 20px;border-radius:999px;border:1px solid #cfe0f7;background:#fff;font:400 15.5px 'Inter Tight',sans-serif;color:#14233f;outline:none" /><div style="display:flex;flex-wrap:wrap;gap:8px">{b.cats.map((choice,i)=>(<button type="button" data-blog-cat={i} style={choice.style}>{t(choice.label)}</button>))}</div></div><div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));gap:20px">{b.items.map((a,i)=>(<><article style="background:linear-gradient(180deg,#fff,#f1f6ff);border:1px solid rgba(255,255,255,.95);border-radius:26px;box-shadow:inset 0 1px 0 #fff,0 12px 32px rgba(26,115,232,.12);overflow:hidden;display:flex;flex-direction:column" data-blog-card={i}><div style={a.art}><span style="width:56px;height:56px;border-radius:18px;display:grid;place-items:center;background:rgba(255,255,255,.22);border:1px solid rgba(255,255,255,.6);box-shadow:inset 0 1px 0 rgba(255,255,255,.7)"><svg viewBox="0 0 24 24" style="width:28px;height:28px;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round"><path d={a.icon}></path></svg></span></div><div style="padding:22px;display:flex;flex-direction:column;gap:10px;flex:1"><span style="font:600 12px 'Inter Tight',sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#1e5fd9">{t(a.cat)}</span><h3 style="margin:0;font:600 18.5px/1.3 'Inter Tight',sans-serif;color:#0B1B3F;letter-spacing:-.01em">{t(a.title)}</h3><p style="margin:0;font:400 14.5px/1.55 'Inter Tight',sans-serif;color:#3d5a85;flex:1">{t(a.ex)}</p><span style="font:400 13px 'Inter Tight',sans-serif;color:#6f82a3">{t(a.meta)}</span></div></article></>))}</div><p style={b.emptyStyle} data-blog-style="empty">{t("No hay artículos con ese filtro por ahora. Prueba con otra categoría o búsqueda.")}</p><div id="suscribete" style="scroll-margin-top:90px;background:linear-gradient(180deg,#fff,#f1f6ff);border:1px solid rgba(255,255,255,.95);border-radius:26px;box-shadow:inset 0 1px 0 #fff,0 12px 32px rgba(26,115,232,.12);padding:clamp(24px,4vw,40px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:24px 44px;align-items:center"><div style="display:flex;flex-direction:column;gap:10px"><h2 style="margin:0;font:600 clamp(24px,3vw,32px)/1.15 'Inter Tight',sans-serif;letter-spacing:-.02em;color:#0B1B3F">{t("Suscríbete a nuestros contenidos")}</h2><p style="margin:0;font:400 16px/1.55 'Inter Tight',sans-serif;color:#3d5a85">{t("Recibe consejos, novedades y recursos para tu agencia. Sin spam.")}</p></div><div><div style={b.formStyle} data-blog-style="form"><div style="display:flex;flex-wrap:wrap;gap:14px"><label style="display:flex;flex-direction:column;gap:6px;flex:1 1 220px;min-width:0"><span style="font:600 13.5px 'Inter Tight',sans-serif;color:#27456f">{t("Nombre")}</span><input type="text" placeholder={t("Tu nombre")} data-blog-input="n" style={b.sN} data-blog-style="n" /><span style="font:500 12.5px 'Inter Tight',sans-serif;color:#d93a3a" data-blog-field="eN">{t(b.eN)}</span></label><label style="display:flex;flex-direction:column;gap:6px;flex:1 1 220px;min-width:0"><span style="font:600 13.5px 'Inter Tight',sans-serif;color:#27456f">{t("Correo electrónico")}</span><input type="email" placeholder={t("tu@correo.com")} data-blog-input="e" style={b.sE} data-blog-style="e" /><span style="font:500 12.5px 'Inter Tight',sans-serif;color:#d93a3a" data-blog-field="eE">{t(b.eE)}</span></label></div><button type="button" data-blog-submit="" style="display:flex;align-items:center;justify-content:center;gap:8px;height:48px;padding:0 24px;border-radius:999px;text-decoration:none;cursor:pointer;font:600 14.5px 'Inter Tight',sans-serif;color:#fff;background:linear-gradient(180deg,#5aa8ff,#1A73E8);border:1px solid rgba(255,255,255,.6);box-shadow:inset 0 1px 1px rgba(255,255,255,.7),0 10px 22px rgba(35,105,240,.38);width:100%;margin-top:14px;height:50px">{t("Suscribirme →")}</button></div><div style={b.okStyle} data-blog-style="ok"><b style="font:600 20px 'Inter Tight',sans-serif;color:#0B1B3F">{t("¡Gracias,")} <span data-blog-field="name">{b.name}</span>{t("!")}</b><span style="font:400 15px/1.5 'Inter Tight',sans-serif;color:#3d5a85">{t("Te enviaremos los nuevos contenidos a")} <span data-blog-field="email">{b.email}</span>{t(".")}</span></div></div></div></div> <div style="height:8px"></div> <div style="height:8px"></div> <div style="height:8px"></div> </div>
<script id="blog-data" type="application/json" set:html={blogJson} />
