[{\"label\":\"¿Mis datos están protegidos?\",\"style\":\"cursor:pointer;min-height:36px;padding:7px 14px;border-radius:14px;text-align:left;font:500 13px/1.3 'Inter Tight',sans-serif;border:1px solid #d3e3f8;color:#27456f;background:#fff\"},{\"label\":\"¿Qué pasa con las bases de datos de mis clientes?\",\"style\":\"cursor:pointer;min-height:36px;padding:7px 14px;border-radius:14px;text-align:left;font:500 13px/1.3 'Inter Tight',sans-serif;border:1px solid #d3e3f8;color:#27456f;background:#fff\"},{\"label\":\"¿Cumplen la ley de tratamiento de datos?\",\"style\":\"cursor:pointer;min-height:36px;padding:7px 14px;border-radius:14px;text-align:left;font:500 13px/1.3 'Inter Tight',sans-serif;border:1px solid #d3e3f8;color:#27456f;background:#fff\"}],[{\"label\":\"¿Por qué no firmo un contrato de licencia?\",\"style\":\"cursor:pointer;min-height:36px;padding:7px 14px;border-radius:14px;text-align:left;font:500 13px/1.3 'Inter Tight',sans-serif;border:1px solid #d3e3f8;color:#27456f;background:#fff\"},{\"label\":\"¿Qué pasa si decido no continuar?\",\"style\":\"cursor:pointer;min-height:36px;padding:7px 14px;border-radius:14px;text-align:left;font:500 13px/1.3 'Inter Tight',sans-serif;border:1px solid #d3e3f8;color:#27456f;background:#fff\"},{\"label\":\"¿Qué ocurre cuando se renueva?\",\"style\":\"cursor:pointer;min-height:36px;padding:7px 14px;border-radius:14px;text-align:left;font:500 13px/1.3 'Inter Tight',sans-serif;border:1px solid #d3e3f8;color:#27456f;background:#fff\"}]],\"data\":[{\"c\":0,\"q\":\"¿Qué es Softseguros?\",\"a\":\"Es una plataforma para agencias de seguros que reúne en un solo panel el CRM, la sincronización con los portales de las aseguradoras, la cobranza y los recordatorios de renovación por WhatsApp.\",\"k\":\"¿qué es softseguros? crm software que es\"},{\"c\":0,\"q\":\"¿Con qué aseguradoras se conecta?\",\"a\":\"Hoy se conecta con Sura, HDI, Bolívar, AXA, Allianz y Qualitas. Se están sumando más, y puedes pedir la tuya.\",\"k\":\"¿con qué aseguradoras se conecta? aseguradoras sura hdi bolivar axa allianz qualitas portal\"},{\"c\":0,\"q\":\"¿Tengo que digitar mis pólizas para empezar?\",\"a\":\"No. Los bots importan pólizas, pagos y certificados cuando ingresas las claves de los portales, y un lector con IA procesa los PDF de pólizas que llegan por correo.\",\"k\":\"¿tengo que digitar mis pólizas para empezar? digitar pólizas importar bots pdf\"},{\"c\":0,\"q\":\"¿Cómo funcionan los recordatorios de renovación?\",\"a\":\"Se envían de forma automática por WhatsApp y correo, con la programación que tú definas. Las respuestas llegan a tu bandeja de WhatsApp Business.\",\"k\":\"¿cómo funcionan los recordatorios de renovación? recordatorios renovación whatsapp correo\"},{\"c\":0,\"q\":\"¿Softseguros es partner de Meta?\",\"a\":\"Sí. Softseguros es partner de Meta y las conversaciones se gestionan en WhatsApp Business.\",\"k\":\"¿softseguros es partner de meta? meta whatsapp business partner oficial\"},{\"c\":1,\"q\":\"¿Cuánto cuesta Softseguros?\",\"a\":\"USD 380 por usuario al año, con un mínimo de 2 usuarios. El pago se hace en pesos colombianos según la TRM del día de la orden de pedido; como referencia, unos COP 1.200.000 por usuario.\",\"k\":\"¿cuánto cuesta softseguros? precio costo cuanto vale cuesta tarifa licencia\"},{\"c\":1,\"q\":\"¿Puedo probar Softseguros gratis?\",\"a\":\"Sí. Hay una demo de 7 días sin tarjeta de crédito para usar con tu propia operación, y también puedes agendar una demo de 20 minutos con un asesor. La prueba es previa a la compra y no hace parte de la licencia.\",\"k\":\"¿puedo probar softseguros gratis? prueba gratis demo probar\"},{\"c\":1,\"q\":\"¿Qué incluye cada usuario?\",\"a\":\"Con menos de 3 usuarios: 1 línea de WhatsApp, 600 correos, 100 lecturas de PDF y 10 GB por usuario. Desde 3 usuarios: 2 líneas de WhatsApp, 800 correos, 130 PDF y 15 GB por usuario, además de marca blanca y entrenamientos ilimitados.\",\"k\":\"¿qué incluye cada usuario? incluye usuario correos pdf almacenamiento marca blanca\"},{\"c\":1,\"q\":\"¿Cómo pido una cotización?\",\"a\":\"Entra a la página de Precios, elige el número de usuarios y pídela por WhatsApp. Después recibes la orden de pedido por correo con las condiciones.\",\"k\":\"¿cómo pido una cotización? cotización cotizar pedido orden\"},{\"c\":2,\"q\":\"¿Qué es el Módulo Comercial?\",\"a\":\"Es la herramienta de ventas y retención: agentes de IA en WhatsApp, embudos y páginas de captación, campañas, calendarios, reseñas y un pipeline de ventas. Pide a un asesor las condiciones según tu número de usuarios.\",\"k\":\"¿qué es el módulo comercial? módulo comercial ventas agentes ia embudos campañas\"},{\"c\":2,\"q\":\"¿Qué es el Multicotizador de Autos?\",\"a\":\"Cotiza un vehículo en varias aseguradoras a la vez y compara las ofertas en un solo PDF.\",\"k\":\"¿qué es el multicotizador de autos? multicotizador autos cotizador vehículo\"},{\"c\":2,\"q\":\"¿Funciona con asistentes de inteligencia artificial?\",\"a\":\"Sí, mediante una conexión MCP que permite a un asistente de IA consultar renovaciones, saldos vencidos y el estado de la sincronización.\",\"k\":\"¿funciona con asistentes de inteligencia artificial? inteligencia artificial ia asistente mcp claude chatgpt\"},{\"c\":2,\"q\":\"¿Se conecta con otros programas?\",\"a\":\"Tiene una API pública para que tu equipo técnico o un desarrollador conecte otras herramientas. Softseguros no desarrolla ni mantiene esas conexiones.\",\"k\":\"¿se conecta con otros programas? api integraciones otros programas conectar\"},{\"c\":3,\"q\":\"¿Cuánto tiempo toma implementar Softseguros?\",\"a\":\"Conectar la primera aseguradora toma menos de una hora, y el equipo te acompaña con soporte humano en el resto de la puesta en marcha.\",\"k\":\"¿cuánto tiempo toma implementar softseguros? implementar implementación tiempo cuanto demora\"},{\"c\":3,\"q\":\"Ya acepté las condiciones, ¿cómo empiezo?\",\"a\":\"Recibes por correo las instrucciones iniciales y tus claves de acceso. Después el equipo te contacta para agendar las capacitaciones.\",\"k\":\"ya acepté las condiciones, ¿cómo empiezo? empezar iniciar claves acceso capacitación\"},{\"c\":3,\"q\":\"¿Dónde encuentro ayuda para usar el software?\",\"a\":\"En el centro de ayuda hay videos y guías (entrenamientos.softseguros.com). El soporte está disponible mientras tu licencia esté vigente y los pagos al día.\",\"k\":\"¿dónde encuentro ayuda para usar el software? ayuda soporte guías videos capacitación\"},{\"c\":4,\"q\":\"¿Mis datos están protegidos?\",\"a\":\"Sí. Al aceptar los Términos y la orden de pedido, ambas partes aceptan un Acuerdo de Confidencialidad que prohíbe revelar información confidencial a terceros.\",\"k\":\"¿mis datos están protegidos? datos protegidos seguridad confidencialidad\"},{\"c\":4,\"q\":\"¿Qué pasa con las bases de datos de mis clientes?\",\"a\":\"Se rigen por un anexo que cubre protección de información, ciberseguridad, plan de contingencia y copias de respaldo, con restricción de acceso, políticas de seguridad y encriptación.\",\"k\":\"¿qué pasa con las bases de datos de mis clientes? bases de datos clientes backup copias respaldo encriptación\"},{\"c\":4,\"q\":\"¿Cumplen la ley de tratamiento de datos?\",\"a\":\"Sí. Mikomovil SAS, la empresa detrás de Softseguros, cumple la Ley 1581 de 2012, vigilada por la Superintendencia de Industria y Comercio.\",\"k\":\"¿cumplen la ley de tratamiento de datos? ley 1581 habeas data tratamiento datos\"},{\"c\":5,\"q\":\"¿Por qué no firmo un contrato de licencia?\",\"a\":\"Softseguros usa un esquema más sencillo: el vínculo se forma cuando recibes la orden de pedido por correo y realizas el pago.\",\"k\":\"¿por qué no firmo un contrato de licencia? contrato firma licencia\"},{\"c\":5,\"q\":\"¿Qué pasa si decido no continuar?\",\"a\":\"Cualquiera de las partes puede terminar con 30 días de preaviso. Pagas la licencia hasta que la terminación sea efectiva y los pagos adelantados no se reintegran. Tienes soporte mientras la licencia esté vigente.\",\"k\":\"¿qué pasa si decido no continuar? cancelar terminar no continuar reembolso\"},{\"c\":5,\"q\":\"¿Qué ocurre cuando se renueva?\",\"a\":\"La renovación sigue los mismos parámetros de los Términos del servicio. Las condiciones específicas están en el certificado, que un usuario con perfil gerente puede descargar desde configuración.\",\"k\":\"¿qué ocurre cuando se renueva? renovar renovación contrato certificado\"}],\"accordion\":{\"closed\":{\"icon\":\"flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font:500 20px/1 'Inter Tight',sans-serif;color:#1e5fd9;background:linear-gradient(180deg,#fff,#e4f0ff);border:1px solid #fff;box-shadow:0 4px 10px rgba(26,115,232,.14);transition:transform .2s;transform:rotate(0deg)\",\"ans\":\"display:none\"},\"opened\":{\"icon\":\"flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font:500 20px/1 'Inter Tight',sans-serif;color:#1e5fd9;background:linear-gradient(180deg,#fff,#e4f0ff);border:1px solid #fff;box-shadow:0 4px 10px rgba(26,115,232,.14);transition:transform .2s;transform:rotate(45deg)\",\"ans\":\"padding:0 46px 22px 0;font:400 16px/1.6 'Inter Tight',sans-serif;color:#3d5a85\"}},\"messages\":{\"user\":{\"t\":\"x\",\"row\":\"display:flex;justify-content:flex-end\",\"bub\":\"max-width:min(86%,560px);padding:11px 15px;border-radius:18px;font:400 15px/1.5 'Inter Tight',sans-serif;display:flex;flex-direction:column;gap:8px;color:#fff;background:linear-gradient(180deg,#5aa8ff,#1A73E8);border-bottom-right-radius:6px;box-shadow:0 6px 14px rgba(35,105,240,.28)\",\"href\":\"https://api.whatsapp.com/send?phone=573204863161&text=Hola%2C%20tengo%20una%20pregunta%20sobre%20Softseguros.\",\"linkStyle\":\"display:none\"},\"bot\":{\"t\":\"¡Hola! Soy el chat de preguntas frecuentes de Softseguros. Elige una pregunta o escribe la tuya.\",\"row\":\"display:flex;justify-content:flex-start\",\"bub\":\"max-width:min(86%,560px);padding:11px 15px;border-radius:18px;font:400 15px/1.5 'Inter Tight',sans-serif;display:flex;flex-direction:column;gap:8px;color:#14233f;background:#fff;border:1px solid #e1ecfb;border-bottom-left-radius:6px;box-shadow:0 2px 8px rgba(26,115,232,.08)\",\"href\":\"https://api.whatsapp.com/send?phone=573204863161&text=Hola%2C%20tengo%20una%20pregunta%20sobre%20Softseguros.\",\"linkStyle\":\"display:none\"},\"fallback\":{\"t\":\"x\",\"row\":\"display:flex;justify-content:flex-start\",\"bub\":\"max-width:min(86%,560px);padding:11px 15px;border-radius:18px;font:400 15px/1.5 'Inter Tight',sans-serif;display:flex;flex-direction:column;gap:8px;color:#14233f;background:#fff;border:1px solid #e1ecfb;border-bottom-left-radius:6px;box-shadow:0 2px 8px rgba(26,115,232,.08)\",\"href\":\"https://api.whatsapp.com/send?phone=573204863161&text=Hola%2C%20tengo%20una%20pregunta%20sobre%20Softseguros.\",\"linkStyle\":\"color:#1e5fd9;font:600 14px 'Inter Tight',sans-serif;text-decoration:none\"}}}";
