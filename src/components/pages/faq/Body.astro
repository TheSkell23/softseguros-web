<div style="position:relative;max-width:1120px;margin:0 auto;padding:0 5%"> <div style="height:44px"></div> <div style="padding-top:44px;display:flex;flex-direction:column;gap:28px"><div style="display:flex;flex-direction:column;gap:6px"><h2 style="margin:0;font:600 clamp(26px,3.2vw,36px)/1.12 'Inter Tight',sans-serif;letter-spacing:-.03em;color:#0B1B3F">{t("Pregúntale al chat")}</h2><p style="margin:0;max-width:640px;font:400 16px/1.5 'Inter Tight',sans-serif;color:#3d5a85">{t("Elige una categoría, toca una pregunta o escribe la tuya. Te respondemos al instante.")}</p></div><div id="chat" style="scroll-margin-top:90px;background:linear-gradient(180deg,#fff,#f1f6ff);border:1px solid rgba(255,255,255,.95);border-radius:26px;box-shadow:inset 0 1px 0 #fff,0 12px 32px rgba(26,115,232,.12);overflow:hidden;display:flex;flex-direction:column"><div style="display:flex;align-items:center;gap:12px;padding:16px 22px;border-bottom:1px solid #e1ecfb"><span style="width:40px;height:40px;border-radius:13px;flex:none;display:grid;place-items:center;background:linear-gradient(180deg,#7fdcff,#1779e6);box-shadow:0 6px 14px rgba(15,80,190,.3),inset 0 1px 0 rgba(255,255,255,.8)"><svg viewBox="0 0 24 24" style="width:21px;height:21px;fill:none;stroke:#fff;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round"><path d="M21 12a8.5 8.5 0 01-12.6 7.4L3 21l1.7-5.2A8.5 8.5 0 1121 12z"></path></svg></span><span style="display:flex;flex-direction:column;gap:2px"><b style="font:600 16px/1.2 'Inter Tight',sans-serif;color:#0B1B3F">{t("Chat de preguntas frecuentes")}</b><span style="font:400 13px/1.3 'Inter Tight',sans-serif;color:#6f82a3">{t("Respuestas prediseñadas · para algo más, escribe a un asesor")}</span></span></div><div id="fq-log" style="height:min(46vh,380px);overflow-y:auto;padding:20px 22px;display:flex;flex-direction:column;gap:12px;background:linear-gradient(180deg,#f6faff,#eef5ff)">{f.msgs.map((m) => (<><div style={m.row}><div style={m.bub}><span>{t(m.t)}</span><a href={m.href} target="_blank" rel="noopener" style={m.linkStyle}>{t("Hablar con un asesor →")}</a></div></div></>))}</div><div style="padding:16px 22px 20px;display:flex;flex-direction:column;gap:12px;border-top:1px solid #e1ecfb"><div style="display:flex;flex-wrap:wrap;gap:8px">{f.cats.map((choice,i)=>(<button type="button" data-faq-cat={i} style={choice.style}>{t(choice.label)}</button>))}</div><div style="display:flex;flex-wrap:wrap;gap:8px">{f.chips.map((choice,i)=>(<button type="button" data-faq-chip={i} style={choice.style}>{t(choice.label)}</button>))}</div><div style="display:flex;gap:10px;align-items:center"><input id="fq-in" type="text" aria-label={t("Escribe tu pregunta")} placeholder={t("O escribe tu pregunta, por ejemplo: ¿cuánto cuesta?")} data-faq-input="" data-faq-key="" style="flex:1;min-width:0;height:48px;padding:0 18px;border-radius:999px;border:1px solid #cfe0f7;background:#fff;font:400 15px 'Inter Tight',sans-serif;color:#14233f;outline:none" /><button type="button" data-faq-send="" style="display:inline-flex;border:1px solid rgba(255,255,255,.6);flex:none;align-items:center;justify-content:center;gap:8px;height:48px;padding:0 24px;border-radius:999px;text-decoration:none;cursor:pointer;font:600 14.5px 'Inter Tight',sans-serif;color:#fff;background:linear-gradient(180deg,#5aa8ff,#1A73E8);border:1px solid rgba(255,255,255,.6);box-shadow:inset 0 1px 1px rgba(255,255,255,.7),0 10px 22px rgba(35,105,240,.38)">{t("Enviar")}</button></div></div></div><div style="display:flex;flex-direction:column;gap:6px"><h2 style="margin:0;font:600 clamp(26px,3.2vw,36px)/1.12 'Inter Tight',sans-serif;letter-spacing:-.03em;color:#0B1B3F">{t("Las preguntas más básicas")}</h2><p style="margin:0;max-width:640px;font:400 16px/1.5 'Inter Tight',sans-serif;color:#3d5a85">{t("Lo esencial antes de empezar.")}</p></div><div id="basicas" style="scroll-margin-top:90px;background:linear-gradient(180deg,#fff,#f1f6ff);border:1px solid rgba(255,255,255,.95);border-radius:26px;box-shadow:inset 0 1px 0 #fff,0 12px 32px rgba(26,115,232,.12);padding:6px 28px">{f.basics.map((it) => (<><div style="border-bottom:1px solid #e6eef9"><button type="button" data-faq-toggle="" aria-expanded={it.exp} style="display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;padding:20px 0;border:0;background:transparent;cursor:pointer;text-align:left;font:600 17px/1.35 'Inter Tight',sans-serif;color:#0B1B3F"><span>{t(it.q)}</span><span style={it.icon}>{t("+")}</span></button><div style={it.ans}>{t(it.a)}</div></div></>))}</div></div> <div style="height:8px"></div> <div style="height:8px"></div> <div style="height:8px"></div> </div>
<script id="faq-data" type="application/json" set:html={faqJson} />
