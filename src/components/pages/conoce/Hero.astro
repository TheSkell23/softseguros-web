---
// GENERADO por scripts-migracion/gen-page.mjs desde site/Conoce.dc.html. Los textos pasan por t() (catálogo: Fase 4).
import { pathFor } from '../../../i18n/routes.ts';
import { getT } from '../../../i18n/index.ts';
import type { Lang, PageKey } from '../../../i18n/routes.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);

const link = (key: PageKey, hash = ''): string => pathFor(key, lang) + hash;
